<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0B1220"
    android:padding="28dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/app_info_gate_title"
            android:textColor="#F8FAFC"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:text="@string/app_info_gate_message"
            android:textColor="#CBD5E1"
            android:textSize="15sp" />

        <EditText
            android:id="@+id/app_info_password"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:background="#1E293B"
            android:hint="@string/app_info_password_hint"
            android:inputType="textPassword"
            android:padding="14dp"
            android:textColor="#F8FAFC"
            android:textColorHint="#94A3B8" />

        <TextView
            android:id="@+id/app_info_error"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="#F87171"
            android:textSize="13sp"
            android:visibility="gone" />

        <Button
            android:id="@+id/app_info_confirm"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/app_info_enter_password" />

        <Button
            android:id="@+id/app_info_go_back"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/go_back" />
    </LinearLayout>
</FrameLayout>
